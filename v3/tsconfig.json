{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "paths": {
      "@usd/core": ["./packages/core/src/index.ts"]
    }
  },
  "include": ["app", "api", "db", "ingest", "packages", "scripts", "tests", "worker", "env.d.ts", "vite.config.ts", "vitest.config.ts"]
}
