{
  "name": "us-districts",
  "version": 1,
  "colorScheme": "light",
  "color": {
    "bg": "#ffffff",
    "panel": "#ffffff",
    "border": "#e7e5e4",
    "text": "#1c1917",
    "textMuted": "#78716c",
    "dem": "#2563eb",
    "rep": "#dc2626",
    "other": "#a8a29e",
    "noData": "#a8a29e",
    "noDataFill": "#d6d3d1",
    "mapNeutral": "#f5f5f4",
    "glyph": "#111111",
    "glyphOn": "#ffffff"
  },
  "glass": {
    "blurPx": 14,
    "saturate": 1.8,
    "unselectedFillTop": "rgba(255,255,255,0.22)",
    "unselectedFillBottom": "rgba(255,255,255,0.14)",
    "unselectedOutline": "rgba(0,0,0,0.85)",
    "unselectedShadow": "inset 0 1px 0 rgba(255,255,255,0.75), 0 1px 2px rgba(0,0,0,0.12)",
    "selectedFillTop": "rgba(0,0,0,0.88)",
    "selectedFillBottom": "rgba(0,0,0,0.92)",
    "selectedOutline": "#ffffff",
    "selectedShadow": "inset 0 1px 0 rgba(255,255,255,0.28), 0 1px 2px rgba(0,0,0,0.18)"
  },
  "space": {
    "tapPx": 48,
    "gapPx": 8,
    "iconX": 27,
    "textX": 52,
    "radiusPx": 24,
    "listRowPx": 28
  },
  "type": {
    "minInputPx": 16,
    "maxLineChars": 32,
    "font": "-apple-system, BlinkMacSystemFont, Segoe UI, Helvetica, Arial, sans-serif"
  },
  "margin": {
    "max": 90
  },
  "marginScale": {
    "demStop": -0.9,
    "even": 0,
    "repStop": 0.9,
    "max": 0.9
  },
  "thumbPx": 30,
  "safeArea": {
    "top": "env(safe-area-inset-top, 0px)",
    "right": "env(safe-area-inset-right, 0px)",
    "bottom": "env(safe-area-inset-bottom, 0px)",
    "left": "env(safe-area-inset-left, 0px)"
  },
  "layoutMode": {
    "map": "map",
    "list": "list"
  }
}
